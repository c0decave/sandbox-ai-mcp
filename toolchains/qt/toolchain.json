{
  "name": "qt",
  "version": "6.12.0",
  "title": "Qt for C++ (the Qt SDK)",
  "description": "Qt 6.12.0 for C++ with CMake and qmake: headers, libraries, CMake packages, mkspecs, plugins, QML modules and the tools (moc, uic, rcc, qmake, qt-cmake, lupdate, lrelease, Designer, Linguist, Assistant, qmllint, qmlformat, qmlls) of the open-source edition: Core, Gui, Widgets, Qml, Quick, Quick Controls, Network, Sql with SQLite, Svg, WebSockets, Charts, Graphs, 3D, Quick 3D, Multimedia, WebEngine, Pdf and the other add-ons. It is built with GCC: compile with GCC and libstdc++ (the image variant gcc, or the host's under Bubblewrap), not with the toolchain cc, whose libc++ cannot link Qt. Qt for Python (pyside6) is attached with it. Without a display Qt draws offscreen (QT_QPA_PLATFORM). The license texts and the sources of these binaries: licenses/ and NOTICE.txt in the tree (https://download.qt.io/official_releases/qt/6.12/6.12.0/single/qt-everywhere-src-6.12.0.tar.xz).",
  "license": "LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only",
  "homepage": "https://doc.qt.io/qt-6/",
  "arches": [
    "x86_64"
  ],
  "commands": {
    "qmake": "bin/qmake",
    "qmake6": "bin/qmake6",
    "qt-cmake": "bin/qt-cmake",
    "qtpaths": "bin/qtpaths",
    "moc": "libexec/moc",
    "uic": "libexec/uic",
    "rcc": "libexec/rcc",
    "lupdate": "bin/lupdate",
    "lrelease": "bin/lrelease",
    "lconvert": "bin/lconvert",
    "designer": "bin/designer",
    "linguist": "bin/linguist",
    "assistant": "bin/assistant",
    "qml": "bin/qml",
    "qmllint": "bin/qmllint",
    "qmlformat": "bin/qmlformat",
    "qmlls": "bin/qmlls",
    "qmlcachegen": "libexec/qmlcachegen",
    "qmltyperegistrar": "libexec/qmltyperegistrar",
    "qmlimportscanner": "libexec/qmlimportscanner",
    "qsb": "bin/qsb",
    "balsam": "bin/balsam"
  },
  "env": {
    "CMAKE_PREFIX_PATH": "{prefix}",
    "Qt6_DIR": "{prefix}/lib/cmake/Qt6",
    "QT_QPA_PLATFORM": "offscreen"
  },
  "caches": {},
  "hosts": [],
  "allow": [],
  "needs": {
    "glibc": "2.34",
    "libraries": [
      "libstdc++.so.6",
      "libgcc_s.so.1",
      "libz.so.1",
      "libzstd.so.1",
      "libglib-2.0.so.0",
      "libgthread-2.0.so.0",
      "libEGL.so.1",
      "libGL.so.1",
      "libX11.so.6",
      "libfontconfig.so.1",
      "libfreetype.so.6",
      "libxkbcommon.so.0",
      "libbrotlicommon.so.1",
      "libbrotlidec.so.1",
      "libgssapi_krb5.so.2",
      "libdbus-1.so.3"
    ]
  },
  "requires": [
    "pyside6"
  ],
