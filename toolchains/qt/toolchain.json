    {
      "files": {
        "main.cpp": "#include <QApplication>\n#include <QImage>\n#include <QLabel>\n#include <QQuickView>\n#include <QSet>\n#include <QSqlDatabase>\n#include <QTimer>\n#include <QUrl>\n#include <chrono>\n#include <cstdio>\n\nusing namespace std::chrono_literals;\n\nstatic int colours(const QImage &image)\n{\n    QSet<QRgb> seen;\n    for (int x = 0; x < image.width(); x += 4)\n        for (int y = 0; y < image.height(); y += 4)\n            seen.insert(image.pixel(x, y));\n    return seen.size();\n}\n\nint main(int argc, char **argv)\n{\n    QApplication app(argc, argv);\n    QLabel label(QObject::tr(\"hello from Qt\"));\n    label.resize(200, 60);\n    label.show();\n    QQuickView view;\n    view.setSource(QUrl::fromLocalFile(QStringLiteral(\"hello.qml\")));\n    view.show();\n    QSqlDatabase db = QSqlDatabase::addDatabase(QStringLiteral(\"QSQLITE\"));\n    db.setDatabaseName(QStringLiteral(\":memory:\"));\n    // (a std::chrono argument: only a C++ library of the ABI Qt was built with links this)\n    QTimer::singleShot(500ms, &app, [&] {\n        const QImage widget = label.grab().toImage(), quick = view.grabWindow();\n        widget.save(QStringLiteral(\"widget.png\"));\n        std::printf(\"qt %s %s widget %d quick %d sqlite %d\\n\", qVersion(), qPrintable(app.platformName()),\n                    colours(widget) > 1, colours(quick) > 1, db.open());\n        app.quit();\n    });\n    return app.exec();\n}\n",
        "hello.qml": "import QtQuick\nimport QtQuick.Controls\n\nRectangle {\n    width: 160; height: 120; color: \"#2060c0\"\n    Button { text: qsTr(\"hello from QML\"); anchors.centerIn: parent }\n}\n",
        "CMakeLists.txt": "cmake_minimum_required(VERSION 3.22)\nproject(hello LANGUAGES CXX)\nset(CMAKE_CXX_STANDARD 17)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nfind_package(Qt6 REQUIRED COMPONENTS Widgets Quick QuickControls2 Sql Svg Network WebSockets Charts)\nqt_standard_project_setup()\nqt_add_executable(hello main.cpp)\ntarget_link_libraries(hello PRIVATE Qt6::Widgets Qt6::Quick Qt6::Sql)\n"
      },
      "run": "cmake -S . -B build -G Ninja >cmake.log 2>&1 && cmake --build build >>cmake.log 2>&1 || { tail -n 40 cmake.log; exit 1; }; ./build/hello && test -s widget.png",
      "expect": "offscreen widget 1 quick 1 sqlite 1"
    },
    {
      "files": {
        "hello.pro": "QT += widgets quick sql\nCONFIG += c++17\nSOURCES += main.cpp\nTARGET = hello_qmake\n"
      },
      "run": "mkdir -p qm && cd qm && qmake ../hello.pro >../qmake.log 2>&1 && make -j2 >>../qmake.log 2>&1 || { tail -n 40 ../qmake.log; exit 1; }; cd .. && ./qm/hello_qmake",
      "expect": "offscreen widget 1 quick 1 sqlite 1"
    },
    {
      "files": {
        "form.ui": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ui version=\"4.0\">\n <class>Form</class>\n <widget class=\"QWidget\" name=\"Form\">\n  <widget class=\"QPushButton\" name=\"button\">\n   <property name=\"text\"><string>hello</string></property>\n  </widget>\n </widget>\n</ui>\n"
      },
      "run": "uic form.ui -o ui_form.h && grep -c Ui_Form ui_form.h >/dev/null && moc --version && qmllint hello.qml && lupdate main.cpp -ts hello_de.ts >/dev/null && lrelease hello_de.ts -qm hello_de.qm >/dev/null && test -s hello_de.qm && qtpaths --qt-version",
      "expect": "moc 6."
    }
  ],
