{
  "name": "zig",
  "version": "0.17.1",
  "title": "Zig",
  "description": "The Zig compiler: one static program with its own C and C++ compiler (zig cc, zig c++), linker and the headers of glibc and musl. Nothing but the kernel is needed. Its caches go to ~/.cache/zig and ./.zig-cache.",
  "license": "MIT AND Apache-2.0 WITH LLVM-exception",
  "homepage": "https://ziglang.org",
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "commands": {
    "zig": "zig"
  },
  "env": {},
  "caches": {},
  "hosts": [],
  "allow": [
    "github"
  ],
  "needs": {
    "glibc": null,
    "libraries": []
  },
  "requires": [],
  "build": [
    {
      "fetch": "zig.whl",
      "url": {
        "x86_64": "https://files.pythonhosted.org/packages/59/e3/2a34676370a11c36b7cd04ffb2439c1089c0530cf4b01408c77cf7f8d9c3/ziglang-0.17.1-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.musllinux_1_1_x86_64.whl",
        "aarch64": "https://files.pythonhosted.org/packages/91/72/bb7c4f098ba3e535fa2ebefd9f26327ba63fb0672562959255cb5dd37aff/ziglang-0.17.1-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.musllinux_1_1_aarch64.whl"
      },
      "sha256": {
        "x86_64": "ea6cc5d87b033cf0aedfbc8f9549a908cae6c50ac31f1698188fa48a74524b54",
        "aarch64": "b7c5f02fccd40f89b999ee16a1f5ddced56e6182370f8affe494bcf8a28cf07e"
      },
      "released": "2026-11-05"
    },
    {
      "unpack": "zig.whl",
      "strip": 1,
      "only": [
        "zig",
        "lib",
        "doc"
      ]
    },
    {
      "chmod": "zig",
      "mode": "755"
    }
  ],
  "smoke": [
    {
      "run": "zig version",
      "expect": "0.17.1"
    },
    {
      "files": {
        "hello.c": "#include <stdio.h>\nint main(void) { puts(\"hello from c\"); return 0; }\n"
      },
      "run": "zig cc hello.c -o hello && ./hello",
      "expect": "hello from c"
    },
    {
      "files": {
        "hello.zig": "const std = @import(\"std\");\n\npub fn main() void {\n    std.debug.print(\"hello from zig\\n\", .{});\n}\n"
      },
      "run": "zig run hello.zig 2>&1",
      "expect": "hello from zig"
    }
  ],
  "notes": "The Zig project's own wheel on PyPI (ziglang/zig-pypi repackages the tarballs of ziglang.org, which publishes minisign signatures: ziglang.org was not reachable where these pins were made). The hashes are PyPI's."
}
