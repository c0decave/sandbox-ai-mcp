{
  "name": "capa",
  "network": "none",
  "memory": "1g",
  "mounts": [
    {
      "host": "${FIXTURES}",
      "target": "/work"
    }
  ],
  "expect_tools": [
    "capa_analyze",
    "get_analysis_results"
  ],
  "calls": [
    {
      "tool": "capa_analyze",
      "arguments": {
        "filepath": "/work/caps"
      },
      "expect": "act as TCP client",
      "timeout": 600
    },
    {
      "tool": "list_active_scans",
      "arguments": {},
      "expect": "\"active_scans\": []"
    },
    {
      "tool": "get_analysis_results",
      "arguments": {
        "scan_id": "00000000"
      },
      "expect": "Analysis not found (the last",
      "expect_error": true
    },
    {
      "tool": "capa_analyze",
      "arguments": {
        "filepath": "/etc/passwd"
      },
      "expect": "only paths under /work",
      "expect_error": true
    }
  ],
  "start_timeout": 120
}
