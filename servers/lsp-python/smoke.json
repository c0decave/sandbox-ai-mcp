{
  "name": "lsp-python",
  "network": "none",
  "memory": "1g",
  "mounts": [
    {
      "target": "/work",
      "fresh": true,
      "seed": [
        {
          "path": "main.py",
          "text": "from pkg.shapes import Circle, total_area\n\ncircles = [Circle(1.0), Circle(2.5)]\nprint(total_area(circles))\nbroken: int = \"not a number\"\n"
        },
        {
          "path": "pkg/__init__.py",
          "text": ""
        },
        {
          "path": "pkg/shapes.py",
          "text": "\"\"\"Shapes for the smoke test.\"\"\"\n\n\nclass Circle:\n    \"\"\"A circle with a radius.\"\"\"\n\n    def __init__(self, radius: float) -> None:\n        self.radius = radius\n\n    def area(self) -> float:\n        \"\"\"The area of the circle.\"\"\"\n        return 3.14159 * self.radius * self.radius\n\n\ndef total_area(shapes: list[Circle]) -> float:\n    return sum(shape.area() for shape in shapes)\n"
        },
        {
          "path": "escape.py",
          "symlink": "/etc/passwd"
        }
      ]
    }
  ],
  "expect_tools": [
    "definition",
    "diagnostics",
    "document_symbols",
    "hover",
    "references",
    "workspace_symbols"
  ],
  "calls": [
    {
      "tool": "document_symbols",
      "arguments": {
        "file": "pkg/shapes.py"
      },
      "expect": "\"name\": \"total_area\""
    },
    {
      "tool": "definition",
      "arguments": {
        "file": "main.py",
        "line": 4,
        "symbol": "total_area"
      },
      "expect": "\"text\": \"def total_area(shapes: list[Circle]) -> float:\""
    },
    {
      "tool": "references",
      "arguments": {
        "file": "pkg/shapes.py",
        "line": 4,
        "symbol": "Circle",
        "include_declaration": true
      },
      "expect": "\"file\": \"main.py\""
    },
    {
      "tool": "hover",
      "arguments": {
        "file": "main.py",
        "line": 3,
        "symbol": "Circle"
      },
      "expect": "class Circle(radius: float)"
    },
    {
      "tool": "diagnostics",
      "arguments": {
        "file": "main.py"
      },
      "expect": "is not assignable to declared type"
    },
    {
      "tool": "workspace_symbols",
      "arguments": {
        "query": "total_area"
      },
      "expect": "\"file\": \"pkg/shapes.py\""
    },
    {
      "tool": "definition",
      "arguments": {
        "file": "../../etc/passwd",
        "line": 1,
        "column": 1
      },
      "expect": "is outside the project",
      "expect_error": true
    },
    {
      "tool": "hover",
      "arguments": {
        "file": "escape.py",
        "line": 1,
        "column": 1
      },
      "expect": "is outside the project",
      "expect_error": true
    },
    {
      "tool": "hover",
      "arguments": {
        "file": "main.py",
        "line": 999,
        "column": 1
      },
      "expect": "line: 1 to",
      "expect_error": true
    }
  ]
}
