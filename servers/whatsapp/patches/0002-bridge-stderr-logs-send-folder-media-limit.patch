+// mediaLimit is WHATSAPP_MEDIA_MB (1-2000, default 64) in bytes (sandbox-ai-mcp).
+func mediaLimit() (uint64, error) {
+	value := os.Getenv("WHATSAPP_MEDIA_MB")
+	if value == "" {
+		return 64 << 20, nil
+	}
+	mb, err := strconv.Atoi(value)
+	if err != nil || mb < 1 || mb > 2000 {
+		return 0, fmt.Errorf("WHATSAPP_MEDIA_MB=%q: a number of MiB from 1 to 2000", value)
+	}
+	return uint64(mb) << 20, nil
+}
+
+// declaredLength is the file size the message gives for the media DownloadAny would fetch (sandbox-ai-mcp).
+func declaredLength(msg *waE2E.Message) uint64 {
+	switch {
+	case msg.ImageMessage != nil:
+		return msg.ImageMessage.GetFileLength()
+	case msg.VideoMessage != nil:
+		return msg.VideoMessage.GetFileLength()
+	case msg.AudioMessage != nil:
+		return msg.AudioMessage.GetFileLength()
+	case msg.DocumentMessage != nil:
+		return msg.DocumentMessage.GetFileLength()
+	case msg.StickerMessage != nil:
+		return msg.StickerMessage.GetFileLength()
+	}
+	return 0
+}
+
+// sendable is the real path of a file the agent asks to send (send_media, a group photo), which must lie under
+// WA_SEND_DIR (the image sets /send, a folder the user mounts read-only) and not under the data folder: the
+// session's keys (session.db) and the message database cannot be sent to anyone (sandbox-ai-mcp).
+func (b *bridge) sendable(p string) (string, error) {
+	root := os.Getenv("WA_SEND_DIR")
+	if root == "" {
+		return "", errors.New("sending files is off (WA_SEND_DIR is not set)")
+	}
+	root, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return "", err
+	}
+	real, err := filepath.EvalSymlinks(p)
+	if err != nil {
+		return "", err
+	}
+	rel, err := filepath.Rel(root, real)
+	if err != nil || rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return "", fmt.Errorf("%s: only files under %s can be sent", p, root)
+	}
+	if _, err := b.insideDataDir(real); err == nil {
+		return "", fmt.Errorf("%s: a file of the data folder cannot be sent", p)
+	}
+	return real, nil
+}
