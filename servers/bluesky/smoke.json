{
  "name": "bluesky",
  "network": "allowlist",
  "hosts": [
    "bsky.social:443",
    "public.api.bsky.app:443"
  ],
  "expect_tools": [
    "delete_post",
    "get_post_thread",
    "get_profile",
    "list_my_posts",
    "post",
    "thread"
  ],
  "env": {
    "BLUESKY_HANDLE": "sandbox-ai-mcp-smoke.example",
