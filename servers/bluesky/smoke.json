  "calls": [
    {
      "tool": "get_profile",
      "arguments": {},
      "expect": "Bluesky refused the sign-in",
      "expect_error": true,
      "timeout": 60
    },
    {
      "tool": "post",
      "arguments": {
        "text": "Smoke test"
      },
      "expect": "writing is off",
      "expect_error": true
    },
    {
      "tool": "thread",
      "arguments": {
        "posts": [
          "Smoke",
          "test"
        ]
      },
      "expect": "writing is off",
      "expect_error": true
    },
    {
      "tool": "delete_post",
