{
  "name": "files",
  "network": "none",
  "mounts": [
    {
      "target": "/work",
      "fresh": true,
      "writable": true,
      "seed": [
        {
          "path": "escape",
          "symlink": "/etc"
        },
        {
          "path": "docs/readme.txt",
          "text": "files smoke test\n"
        }
      ]
    }
  ],
  "expect_tools": [
    "append_file",
    "apply_patch",
    "checksum",
    "copy",
    "delete",
    "delete_lines",
    "diff",
    "edit_file",
    "glob",
    "insert_lines",
    "list_dir",
    "mkdir",
    "move",
    "read_file",
    "search",
    "stat",
    "write_file",
    "write_markdown"
  ],
  "calls": [
    {
      "tool": "write_markdown",
      "arguments": {
        "path": "notes/plan.md",
        "content": "```markdown\n#Plan\n\n#Plan\nA first draft.   \n\n```sh\nls\n```\n```",
        "create_dirs": true
      },
      "expect": "the whole content was wrapped in a code fence (markdown): unwrapped it"
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "/work/notes/plan.md"
      },
      "expect": "# Plan\\n\\nA first draft.\\n\\n```sh\\nls\\n```\\n"
    },
    {
      "tool": "write_markdown",
      "arguments": {
        "path": "notes/escaped.md",
        "content": "# Escaped\\n\\nOne line\\n- a\\n- b"
      },
      "expect": "decoded 4 \\\\n"
    },
    {
      "tool": "edit_file",
      "arguments": {
        "path": "notes/plan.md",
        "old_text": "A first draft.",
        "new_text": "A second draft."
      },
      "expect": "\"match\": \"exact\""
    },
    {
      "tool": "search",
      "arguments": {
        "pattern": "second draft"
      },
      "expect": "/work/notes/plan.md"
    },
    {
      "tool": "mkdir",
      "arguments": {
        "path": "build/out"
      },
      "expect": "\"action\": \"created\",\n  \"made_folders\""
    },
    {
      "tool": "append_file",
      "arguments": {
        "path": "notes/log.txt",
        "text": "first\n"
      },
      "expect": "the file did not exist: created it"
    },
    {
      "tool": "append_file",
      "arguments": {
        "path": "notes/log.txt",
        "text": "third\n"
      },
      "expect": "\"sha256\": \"ff2d48b6ddeab747a6ab4d0341d204fac20cae884b96eb01a7965ff56663da15\""
    },
    {
      "tool": "insert_lines",
      "arguments": {
        "path": "notes/log.txt",
        "line": 2,
        "text": "second"
      },
      "expect": "\"sha256\": \"f5c962601b413ccda2fc14d64d98479d9fc74c90c2dde15f25ee9922e57f5074\""
    },
    {
      "tool": "delete_lines",
      "arguments": {
        "path": "notes/log.txt",
        "start": 3,
        "end": 3
      },
      "expect": "\"sha256\": \"dbea9325179efe46ea2add94f7b6b745ca983fabb208dc6d34aa064623d7ee23\""
    },
    {
      "tool": "apply_patch",
      "arguments": {
        "path": "notes/log.txt",
        "patch": "--- a/notes/log.txt\n+++ b/notes/log.txt\n@@ -1,2 +1,2 @@\n first\n-second\n+second, patched\n"
      },
      "expect": "\"sha256\": \"de8bf1949c4d1acfc4ebcc6add1dd69f788a9e0f7d1c09c946347f2aa8a37724\""
    },
    {
      "tool": "copy",
      "arguments": {
        "src": "notes/log.txt",
        "dst": "build/out/log.txt"
      },
      "expect": "\"to\": \"/work/build/out/log.txt\""
    },
    {
      "tool": "diff",
      "arguments": {
        "path_a": "notes/log.txt",
        "path_b": "docs/readme.txt"
      },
      "expect": "\"identical\": false,\n  \"lines_added\": 1,\n  \"lines_removed\": 2"
    },
    {
      "tool": "move",
      "arguments": {
        "src": "build/out/log.txt",
        "dst": "build/log-moved.txt"
      },
      "expect": "\"to\": \"/work/build/log-moved.txt\""
    },
    {
      "tool": "stat",
      "arguments": {
        "path": "build/log-moved.txt"
      },
      "expect": "\"size\": 22,\n  \"sha256\": \"de8bf1949c4d1acfc4ebcc6add1dd69f788a9e0f7d1c09c946347f2aa8a37724\""
    },
    {
      "tool": "checksum",
      "arguments": {
        "path": "notes/log.txt"
      },
      "expect": "\"checksum\": \"de8bf1949c4d1acfc4ebcc6add1dd69f788a9e0f7d1c09c946347f2aa8a37724\""
    },
    {
      "tool": "glob",
      "arguments": {
        "pattern": "**/*.txt"
      },
      "expect": "\"/work/build/log-moved.txt\",\n    \"/work/docs/readme.txt\",\n    \"/work/notes/log.txt\""
    },
    {
      "tool": "list_dir",
      "arguments": {
        "path": "/work",
        "depth": 2
      },
      "expect": "\"path\": \"/work/build/log-moved.txt\",\n      \"type\": \"file\",\n      \"size\": 22"
    },
    {
      "tool": "write_file",
      "arguments": {
        "path": "notes/plan.md",
        "content": "clobbered\n"
      },
      "expect": "exists already",
      "expect_error": true
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "../etc/passwd"
      },
      "expect": "'..' is not allowed in a path",
      "expect_error": true
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "escape/passwd"
      },
      "expect": "is a link to /etc, outside /work: links out of the mounted folders are never followed",
      "expect_error": true
    },
    {
      "tool": "write_file",
      "arguments": {
        "path": "/etc/cron.d/x",
        "content": "x"
      },
      "expect": "is outside the folders this server can reach",
      "expect_error": true
    },
    {
      "tool": "delete",
      "arguments": {
        "path": "docs/readme.txt"
      },
      "expect": "/work/.trash/"
    }
  ]
}
