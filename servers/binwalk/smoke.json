{
  "name": "binwalk",
  "network": "none",
  "mounts": [
    {
      "host": "${FIXTURES}",
      "target": "/work"
    }
  ],
  "expect_tools": [
    "binwalk_scan",
    "binwalk_extract",
    "binwalk_entropy",
    "binwalk_hexdump"
  ],
  "calls": [
    {
      "tool": "binwalk_scan",
      "arguments": {
        "filepath": "/work/firmware.bin"
      },
      "expect": "Zip archive data"
    },
    {
      "tool": "binwalk_extract",
      "arguments": {
        "filepath": "/work/firmware.bin"
      },
      "expect": "readme.txt"
    },
    {
      "tool": "binwalk_entropy",
      "arguments": {
        "filepath": "/work/firmware.bin"
      },
      "expect": "\"status\": \"completed\""
    },
    {
      "tool": "binwalk_hexdump",
      "arguments": {
        "filepath": "/work/firmware.bin",
        "offset": 0,
        "length": 32
      },
      "expect": "00000000:"
    },
    {
      "tool": "list_extractions",
      "arguments": {},
      "expect": "\"filename\": \"firmware.bin\""
    },
    {
      "tool": "list_active_scans",
      "arguments": {},
      "expect": "\"count\": 0,\n  \"max_concurrent\": 2"
    },
    {
      "tool": "get_scan_results",
      "arguments": {
        "scan_id": "00000000"
      },
      "expect": "Scan '00000000' not found",
      "expect_error": true
    },
    {
      "tool": "binwalk_scan",
      "arguments": {
        "filepath": "/etc/passwd"
      },
      "expect": "only paths under /work",
      "expect_error": true
    }
  ]
}
