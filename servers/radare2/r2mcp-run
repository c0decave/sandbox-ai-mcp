#!/bin/sh
# r2mcp as this image starts it (the ENTRYPOINT runs this file under tini). In a file of its own because the
# Bubblewrap form takes at most 32 words of an ENTRYPOINT (sandbox-ai's mcp_rootfs), and these flags are 70.
# -s /work : open_file only accepts files under /work (the folder the user mounts), no URI (patch 0001)
# -g none  : radare2's own sandbox (cfg.sandbox) allows no exec, socket, network or disk writes
# -N       : no MCP prompts (r2mcp would load *.r2ai.md from ./prompts, i.e. from /work)
# -e ...   : exactly these 32 tools (tools.json): one page of tools/list; the debugger, search, hexdump
#            and sql tools r2mcp would also accept are refused
# no -r    : the raw run_command / run_javascript / run_script tools stay off
# No "$@": nothing a run line adds reaches r2mcp.
exec /opt/radare2/bin/r2mcp -s /work -g none -N \
  -e analyze \
  -e calculate \
  -e close_file \
  -e decompile_function \
  -e disassemble \
  -e disassemble_function \
  -e get_current_address \
  -e get_function_prototype \
  -e list_all_strings \
  -e list_classes \
  -e list_decompilers \
  -e list_entrypoints \
  -e list_exports \
  -e list_files \
  -e list_functions \
  -e list_functions_tree \
  -e list_imports \
  -e list_libraries \
  -e list_memory_maps \
  -e list_methods \
  -e list_sections \
  -e list_strings \
  -e list_symbols \
  -e open_file \
  -e rename_flag \
  -e rename_function \
  -e set_comment \
  -e set_function_prototype \
  -e show_function_details \
  -e show_info \
  -e use_decompiler \
  -e xrefs_to
