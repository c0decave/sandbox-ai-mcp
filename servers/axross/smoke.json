{
  "name": "axross",
  "network": "none",
  "memory": "1g",
  "pids": 256,
  "tmp": "256m",
  "env": {
    "AXROSS_WRITE": "1"
  },
  "mounts": [
    {
      "target": "/work",
      "fresh": true,
      "writable": true,
      "seed": [
        {
          "path": "escape",
          "symlink": "/etc"
        },
        {
          "path": "docs/readme.txt",
          "text": "axross smoke test\n"
        },
        {
          "path": "docs/.env",
          "text": "TOKEN=not-for-the-agent\n"
        }
      ]
    }
  ],
  "expect_tools": [
    "list_dir",
    "read_file",
    "grep",
    "write_file",
    "remove",
    "remote_profiles",
    "remote_open"
  ],
  "calls": [
    {
      "tool": "list_dir",
      "arguments": {
        "path": "docs"
      },
      "expect": "readme.txt"
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "docs/readme.txt",
        "encoding": "text"
      },
      "expect": "axross smoke test"
    },
    {
      "tool": "grep",
      "arguments": {
        "pattern": "smoke",
        "path": "docs"
      },
      "expect": "\"line_no\": 1"
    },
    {
      "tool": "write_file",
      "arguments": {
        "path": "docs/plan.txt",
        "content": "written by the smoke test\n"
      },
      "expect": "\"size\": 26"
    },
    {
      "tool": "checksum",
      "arguments": {
        "path": "docs/plan.txt"
      },
      "expect": "\"algorithm\": \"sha256\""
    },
    {
      "tool": "remote_profiles",
      "arguments": {},
      "expect": "\"profiles\": []"
    },
    {
      "tool": "list_backends",
      "arguments": {},
      "expect": "\"id\": \"local\""
    },
    {
      "tool": "stat",
      "arguments": {
        "path": "docs/plan.txt"
      },
      "expect": "\"name\": \"plan.txt\", \"is_dir\": false, \"size\": 26"
    },
    {
      "tool": "mkdir",
      "arguments": {
        "path": "build/out"
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "copy",
      "arguments": {
        "src": "docs/plan.txt",
        "dst": "build/plan-copy.txt"
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "rename",
      "arguments": {
        "src": "build/plan-copy.txt",
        "dst": "build/out/plan-moved.txt"
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "bulk_copy",
      "arguments": {
        "src": "docs",
        "dst": "backup"
      },
      "expect": "\"dst\": \"/work/backup/plan.txt\", \"size\": 26, \"action\": \"copied\""
    },
    {
      "tool": "symlink",
      "arguments": {
        "target": "plan.txt",
        "link_path": "docs/plan-link"
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "hardlink",
      "arguments": {
        "target": "docs/plan.txt",
        "link_path": "docs/plan-hard"
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "walk",
      "arguments": {
        "path": "build"
      },
      "expect": "\"path\": \"/work/build/out/plan-moved.txt\""
    },
    {
      "tool": "recursive_checksum",
      "arguments": {
        "path": "backup"
      },
      "expect": "\"checksum\": \"2327f3c5c80afe46922fa0c5ed60c526693a03c95c51c4afdc1d9bd088b76333\""
    },
    {
      "tool": "search",
      "arguments": {
        "needle": "plan"
      },
      "expect": "[]",
      "expect_ok": true
    },
    {
      "tool": "list_versions",
      "arguments": {
        "path": "docs/plan.txt"
      },
      "expect": "[]",
      "expect_ok": true
    },
    {
      "tool": "open_version_read",
      "arguments": {
        "path": "docs/plan.txt",
        "version_id": "1"
      },
      "expect": "does not expose file version history",
      "expect_error": true
    },
    {
      "tool": "remove",
      "arguments": {
        "path": "build",
        "recursive": true
      },
      "expect": "{\"ok\": true}",
      "expect_ok": true
    },
    {
      "tool": "remote_close",
      "arguments": {
        "backend": "profile:nowhere"
      },
      "expect": "no open backend 'profile:nowhere' in this session",
      "expect_error": true
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "../etc/passwd"
      },
      "expect": "escapes the configured MCP root",
      "expect_error": true
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "escape/passwd"
      },
      "expect": "via symlink",
      "expect_error": true
    },
    {
      "tool": "read_file",
      "arguments": {
        "path": "docs/.env"
      },
      "expect": "credentials, keys or secrets",
      "expect_error": true
    },
    {
      "tool": "write_file",
      "arguments": {
        "path": "/etc/cron.d/x",
        "content": "x"
      },
      "expect": "escapes the configured MCP root",
      "expect_error": true
    },
    {
      "tool": "chmod",
      "arguments": {
        "path": "docs/plan.txt",
        "mode": "4755"
      },
      "expect": "setuid",
      "expect_error": true
    },
    {
      "tool": "remote_open",
      "arguments": {
        "profile": "nowhere"
      },
      "expect": "no saved profile named 'nowhere'",
      "expect_error": true
    }
  ]
}
