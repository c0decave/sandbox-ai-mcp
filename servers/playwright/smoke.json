{
  "name": "playwright",
  "network": "full",
  "memory": "2g",
  "cpus": 2,
  "pids": 512,
  "tmp": "768m",
  "start_timeout": 120,
  "expect_tools": [
    "browser_navigate",
    "browser_snapshot",
    "browser_evaluate",
    "browser_take_screenshot",
    "browser_run_code_unsafe"
  ],
  "calls": [
    {
      "tool": "browser_navigate",
      "arguments": {
        "url": "data:text/html,<title>sandbox-ai%20smoke</title><h1>Hello%20from%20sandbox-ai-mcp</h1><button>Press%20me</button>"
      },
      "expect": "Page URL: data:text/html",
      "timeout": 180
    },
    {
      "tool": "browser_snapshot",
      "arguments": {},
      "expect": "Hello from sandbox-ai-mcp"
    },
    {
      "tool": "browser_evaluate",
      "arguments": {
        "function": "() => document.title"
      },
      "expect": "sandbox-ai smoke"
    },
    {
      "tool": "browser_evaluate",
      "arguments": {
        "function": "() => { const rows = []; for (let i = 0; i < 40000; i++) rows.push('<div class=\"r\"><b>row ' + i + '</b> ' + 'sandbox-ai smoke text to fill the page '.repeat(8) + '</div>'); document.body.innerHTML = rows.join(''); for (let i = 0; i < 6; i++) { const c = document.createElement('canvas'); c.width = 4000; c.height = 4000; const g = c.getContext('2d'); g.fillStyle = 'hsl(' + (i * 60) + ',80%,50%)'; g.fillRect(0, 0, 4000, 4000); g.fillStyle = '#000'; g.font = '200px sans-serif'; g.fillText('canvas ' + i, 100, 400); document.body.appendChild(c); } return document.querySelectorAll('div.r').length + ' rows, ' + document.body.innerHTML.length + ' bytes'; }"
      },
      "expect": "40000 rows",
      "timeout": 180
    },
    {
      "tool": "browser_take_screenshot",
      "arguments": {
        "type": "png",
        "filename": "smoke-heavy.png"
      },
      "expect": "smoke-heavy.png",
      "timeout": 180
    },
    {
      "tool": "browser_evaluate",
      "arguments": {
        "function": "() => document.querySelectorAll('canvas').length + ' canvases'"
      },
      "expect": "6 canvases",
      "timeout": 60
    },
    {
      "tool": "browser_navigate",
      "arguments": {
        "url": "file:///etc/passwd"
      },
      "expect": "Access to \"file:\" protocol is blocked",
      "expect_error": true
    },
    {
      "tool": "browser_evaluate",
      "arguments": {
        "function": "() => document.title",
        "filename": "/etc/smoke.json"
      },
      "expect": "outside allowed roots",
      "expect_error": true
    }
  ]
}
