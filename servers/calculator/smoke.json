{
  "name": "calculator",
  "network": "none",
  "expect_tools": [
    "calculate",
    "convert_units",
    "date_add",
    "date_diff"
  ],
  "calls": [
    {
      "tool": "calculate",
      "arguments": {
        "expression": "0.1 + 0.2"
      },
      "expect": "\"result\": \"0.3\""
    },
    {
      "tool": "calculate",
      "arguments": {
        "expression": "(17.5 * 3 + 2) / 4"
      },
      "expect": "\"result\": \"13.625\""
    },
    {
      "tool": "convert_units",
      "arguments": {
        "value": 100,
        "from_unit": "C",
        "to_unit": "F"
      },
      "expect": "\"result\": \"212\""
    },
    {
      "tool": "date_add",
      "arguments": {
        "date": "2024-01-31",
        "months": 1
      },
      "expect": "\"result\": \"2024-02-29\""
    },
    {
      "tool": "date_diff",
      "arguments": {
        "start": "2024-01-31",
        "end": "2024-03-01"
      },
      "expect": "\"days\": 30"
    },
    {
      "tool": "calculate",
      "arguments": {
        "expression": "9**9**9"
      },
      "expect": "an exponent is too large",
      "expect_error": true
    },
    {
      "tool": "calculate",
      "arguments": {
        "expression": "__import__('os').system('id')"
      },
      "expect": "unknown function",
      "expect_error": true
    }
  ]
}
