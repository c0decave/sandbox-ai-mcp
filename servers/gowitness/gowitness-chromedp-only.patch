index 0000000000000000000000000000000000000000..0ab20202eae8c833525f90d80899c0736729a7a2
--- /dev/null
+++ b/pkg/runner/drivers/image_formats.go
@@ -0,0 +1,9 @@
+package driver
+
+// sandbox-ai-mcp: the chromedp driver decodes each screenshot for its perception hash (image.Decode). Upstream
+// registers PNG and JPEG only through go-rod's lib/utils, which this build does not link (the gorod driver is
+// removed), so the two decoders are registered here.
+import (
+	_ "image/jpeg"
+	_ "image/png"
+)
