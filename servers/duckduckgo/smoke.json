{
  "name": "duckduckgo",
  "network": "allowlist",
  "hosts": [
    "html.duckduckgo.com:443"
  ],
  "expect_tools": [
    "web_search"
  ],
  "calls": [
    {
      "tool": "web_search",
      "arguments": {
        "query": "example domain iana",
        "max_results": 3
      },
      "expect": "\"results\"",
      "timeout": 120,
      "upstream_limited": [
        "DuckDuckGo answered HTTP 202",
        "DuckDuckGo answered HTTP 429"
      ]
    },
    {
      "tool": "web_search",
      "arguments": {
        "query": "x",
        "region": "--help"
      },
      "expect": "region: wt-wt",
      "expect_error": true
    }
  ]
}
